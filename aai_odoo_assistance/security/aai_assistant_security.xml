<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aai_assistant" model="ir.module.category">
        <field name="name">AI Assistant</field>
        <field name="sequence">90</field>
    </record>

    <!-- Odoo 19: groups belong to a privilege (shown in the user form), privileges to a category -->
    <record id="privilege_aai_assistant" model="res.groups.privilege">
        <field name="name">AI Assistant</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="module_category_aai_assistant"/>
    </record>

    <record id="group_aai_assistant_user" model="res.groups">
        <field name="name">AI Assistant User</field>
        <field name="privilege_id" ref="privilege_aai_assistant"/>
        <field name="comment">Can see and use the AI Assistant chat window.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Users only see their own conversations -->
    <record id="rule_conversation_own" model="ir.rule">
        <field name="name">AI Assistant: own conversations</field>
        <field name="model_id" ref="model_aai_assistant_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_aai_assistant_user'))]"/>
    </record>
    <record id="rule_message_own" model="ir.rule">
        <field name="name">AI Assistant: own messages</field>
        <field name="model_id" ref="model_aai_assistant_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_aai_assistant_user'))]"/>
    </record>

    <!-- Administrators can audit everything -->
    <record id="rule_conversation_admin" model="ir.rule">
        <field name="name">AI Assistant: all conversations (admin)</field>
        <field name="model_id" ref="model_aai_assistant_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_message_admin" model="ir.rule">
        <field name="name">AI Assistant: all messages (admin)</field>
        <field name="model_id" ref="model_aai_assistant_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
