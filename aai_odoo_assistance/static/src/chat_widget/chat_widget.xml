<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aai_odoo_assistance.ChatWidget">
        <div t-if="props.fullPage and !state.allowed" class="o_aai_assistant_denied">
            <t t-if="!activated">
                <i class="fa fa-power-off fa-2x mb-3"/>
                <p>The AI Assistant is not activated yet. An administrator must click <strong>Activate</strong>
                    in Settings &gt; AI Assistant.</p>
            </t>
            <t t-else="">
                <i class="fa fa-lock fa-2x mb-3"/>
                <p>You do not have access to the AI Assistant. Ask your administrator to add you to the
                    <strong>AI Assistant User</strong> group.</p>
            </t>
        </div>
        <div t-if="state.allowed"
             t-attf-class="o_aai_assistant d-print-none {{ props.fullPage ? 'o_aai_assistant_fullpage' : 'o_aai_assistant_floating' }}">

            <!-- ============================== Panel ============================== -->
            <div t-if="state.open"
                 t-attf-class="o_aai_assistant_panel {{ state.expanded ? 'o_aai_assistant_expanded' : '' }}"
                 role="dialog" aria-label="AI Assistant">

                <!-- Header -->
                <header class="o_aai_assistant_header">
                    <div class="o_aai_assistant_avatar o_aai_assistant_avatar_bot">
                        <i class="fa fa-magic"/>
                    </div>
                    <div class="o_aai_assistant_title">
                        <div class="o_aai_assistant_name">AI Assistant</div>
                        <div class="o_aai_assistant_status">
                            <t t-if="state.loading">Looking it up…</t>
                            <t t-else="">Live Odoo data</t>
                        </div>
                    </div>
                    <div class="o_aai_assistant_header_actions">
                        <button class="o_aai_assistant_icon_btn" title="New conversation"
                                t-on-click="newChat" t-att-disabled="state.loading">
                            <i class="fa fa-pencil-square-o"/>
                            <span t-if="props.fullPage" class="o_aai_assistant_new_label">New conversation</span>
                        </button>
                        <t t-if="!props.fullPage">
                            <button class="o_aai_assistant_icon_btn d-none d-md-inline-flex"
                                    t-att-title="state.expanded ? 'Collapse' : 'Expand'" t-on-click="toggleExpand">
                                <i t-attf-class="fa {{ state.expanded ? 'fa-compress' : 'fa-expand' }}"/>
                            </button>
                            <button class="o_aai_assistant_icon_btn" title="Open in new tab"
                                    t-on-click="openInNewTab">
                                <i class="fa fa-external-link"/>
                            </button>
                            <button class="o_aai_assistant_icon_btn" title="Close (Esc)" t-on-click="toggle">
                                <i class="fa fa-times"/>
                            </button>
                        </t>
                    </div>
                </header>

                <!-- Messages -->
                <div class="o_aai_assistant_messages" t-ref="list">

                    <!-- Welcome screen -->
                    <div t-if="!state.messages.length" class="o_aai_assistant_welcome">
                        <div class="o_aai_assistant_welcome_icon"><i class="fa fa-magic"/></div>
                        <h5 class="mb-1">Hello<t t-if="firstName">, <t t-esc="firstName"/></t>!</h5>
                        <p class="text-muted mb-3">
                            Ask me about customers, sales, purchases, invoices, stock, projects and more.
                            I can also fetch PDF documents for you.
                        </p>
                        <div class="o_aai_assistant_suggestions">
                            <t t-foreach="suggestionGroups" t-as="group" t-key="group.title">
                                <div class="o_aai_assistant_suggestion_group">
                                    <div class="o_aai_assistant_suggestion_title">
                                        <i t-attf-class="fa {{ group.icon }} me-1"/>
                                        <t t-esc="group.title"/>
                                    </div>
                                    <button t-foreach="group.items" t-as="item" t-key="item"
                                            class="o_aai_assistant_chip"
                                            t-on-click="() => this.useSuggestion(item)">
                                        <t t-esc="item"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Conversation -->
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                        <div t-attf-class="o_aai_assistant_msg o_aai_assistant_msg_{{ msg.role }}">
                            <img t-if="msg.role === 'user'" class="o_aai_assistant_avatar"
                                 t-att-src="userAvatar" alt=""/>
                            <div t-elif="msg.role === 'error'" class="o_aai_assistant_avatar o_aai_assistant_avatar_error">
                                <i class="fa fa-exclamation"/>
                            </div>
                            <div t-else="" class="o_aai_assistant_avatar o_aai_assistant_avatar_bot">
                                <i class="fa fa-magic"/>
                            </div>

                            <div class="o_aai_assistant_body">
                                <div class="o_aai_assistant_bubble">
                                    <div class="o_aai_assistant_text" t-out="renderContent(msg)"/>

                                    <!-- PDF documents -->
                                    <div t-if="pdfLinks(msg).length" class="o_aai_assistant_files">
                                        <a t-foreach="pdfLinks(msg)" t-as="link" t-key="link.url"
                                           t-att-href="link.url" target="_blank" class="o_aai_assistant_file">
                                            <span class="o_aai_assistant_file_icon"><i class="fa fa-file-pdf-o"/></span>
                                            <span class="o_aai_assistant_file_name" t-esc="link.label"/>
                                            <i class="fa fa-download o_aai_assistant_file_action"/>
                                        </a>
                                    </div>

                                    <!-- Records to open in Odoo -->
                                    <div t-if="recordLinks(msg).length" class="o_aai_assistant_records">
                                        <a t-foreach="recordLinks(msg)" t-as="link" t-key="link.url"
                                           t-att-href="link.url" target="_blank" class="o_aai_assistant_chip">
                                            <i class="fa fa-external-link me-1"/>
                                            <t t-esc="link.label"/>
                                        </a>
                                    </div>
                                </div>

                                <div class="o_aai_assistant_meta">
                                    <span t-esc="formatTime(msg)"/>
                                    <button t-if="msg.role === 'assistant'" class="o_aai_assistant_copy"
                                            title="Copy answer" t-on-click="() => this.copy(msg)">
                                        <i class="fa fa-clone"/> Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Typing indicator -->
                    <div t-if="state.loading" class="o_aai_assistant_msg o_aai_assistant_msg_assistant">
                        <div class="o_aai_assistant_avatar o_aai_assistant_avatar_bot"><i class="fa fa-magic"/></div>
                        <div class="o_aai_assistant_body">
                            <div class="o_aai_assistant_bubble o_aai_assistant_typing">
                                <span/><span/><span/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Composer -->
                <footer class="o_aai_assistant_composer">
                    <div class="o_aai_assistant_input_wrap">
                        <textarea t-ref="input" rows="1"
                                  placeholder="Ask about orders, invoices, stock…"
                                  t-model="state.input"
                                  t-on-input="onInput"
                                  t-on-keydown="onKeydown"
                                  t-att-disabled="state.loading"/>
                        <button class="o_aai_assistant_send" t-on-click="send"
                                t-att-disabled="!canSend" title="Send (Enter)">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                    <div class="o_aai_assistant_hint">
                        <kbd>Enter</kbd> to send · <kbd>Shift</kbd>+<kbd>Enter</kbd> new line
                    </div>
                </footer>
            </div>

            <!-- ============================== Launcher ============================== -->
            <button t-elif="!props.fullPage" class="o_aai_assistant_launcher" title="Ask the AI Assistant"
                    aria-label="Open AI Assistant" t-on-click="toggle">
                <i class="fa fa-magic"/>
                <span class="o_aai_assistant_launcher_label">Ask AI</span>
            </button>
        </div>
    </t>

    <!-- Full-page chat (client action, opened in a new tab or from the AI Assistant menu) -->
    <t t-name="aai_odoo_assistance.ChatPage">
        <div class="o_aai_assistant_page o_action">
            <AiAssistantChat fullPage="true"/>
        </div>
    </t>
</templates>
