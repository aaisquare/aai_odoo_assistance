<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aai_odoo_assistance.ChatWidget">
        <div t-if="this.props.fullPage and !this.state.allowed" class="o_aai_assistant_denied">
            <t t-if="!this.activated">
                <i class="oi oi-2x mb-3" data-icon="power_settings_new"/>
                <p>The AI Assistant is not activated yet. An administrator must click <strong>Activate</strong>
                    in Settings &gt; AI Assistant.</p>
            </t>
            <t t-else="">
                <i class="oi oi-2x mb-3" data-icon="lock"/>
                <p>You do not have access to the AI Assistant. Ask your administrator to add you to the
                    <strong>AI Assistant User</strong> group.</p>
            </t>
        </div>
        <div t-if="this.state.allowed"
             t-attf-class="o_aai_assistant d-print-none {{ this.props.fullPage ? 'o_aai_assistant_fullpage' : 'o_aai_assistant_floating' }}">

            <!-- ============================== Panel ============================== -->
            <div t-if="this.state.open"
                 t-attf-class="o_aai_assistant_panel {{ this.state.expanded ? 'o_aai_assistant_expanded' : '' }}"
                 role="dialog" aria-label="AI Assistant">

                <!-- Header -->
                <header class="o_aai_assistant_header">
                    <div class="o_aai_assistant_avatar o_aai_assistant_avatar_bot">
                        <i class="oi" data-icon="wand_stars"/>
                    </div>
                    <div class="o_aai_assistant_title">
                        <div class="o_aai_assistant_name">AI Assistant</div>
                        <div class="o_aai_assistant_status">
                            <t t-if="this.state.loading">Looking it up…</t>
                            <t t-else="">Live Odoo data</t>
                        </div>
                    </div>
                    <div class="o_aai_assistant_header_actions">
                        <button class="o_aai_assistant_icon_btn" title="New conversation"
                                t-on-click="this.newChat" t-att-disabled="this.state.loading">
                            <i class="oi" data-icon="edit_square"/>
                            <span t-if="this.props.fullPage" class="o_aai_assistant_new_label">New conversation</span>
                        </button>
                        <t t-if="!this.props.fullPage">
                            <button class="o_aai_assistant_icon_btn d-none d-md-inline-flex"
                                    t-att-title="this.state.expanded ? 'Collapse' : 'Expand'" t-on-click="this.toggleExpand">
                                <i class="oi" t-att-data-icon="this.state.expanded ? 'fullscreen_exit' : 'fullscreen'"/>
                            </button>
                            <button class="o_aai_assistant_icon_btn" title="Open in new tab"
                                    t-on-click="this.openInNewTab">
                                <i class="oi" data-icon="open_in_new"/>
                            </button>
                            <button class="o_aai_assistant_icon_btn" title="Close (Esc)" t-on-click="this.toggle">
                                <i class="oi" data-icon="close"/>
                            </button>
                        </t>
                    </div>
                </header>

                <!-- Messages -->
                <div class="o_aai_assistant_messages" t-ref="this.listRef">

                    <!-- Welcome screen -->
                    <div t-if="!this.state.messages.length" class="o_aai_assistant_welcome">
                        <div class="o_aai_assistant_welcome_icon"><i class="oi" data-icon="wand_stars"/></div>
                        <h5 class="mb-1">Hello<t t-if="this.firstName">, <t t-out="this.firstName"/></t>!</h5>
                        <p class="text-muted mb-3">
                            Ask me about customers, sales, purchases, invoices, stock, projects and more.
                            I can also fetch PDF documents for you.
                        </p>
                        <div class="o_aai_assistant_suggestions">
                            <t t-foreach="this.suggestionGroups" t-as="group" t-key="group.title">
                                <div class="o_aai_assistant_suggestion_group">
                                    <div class="o_aai_assistant_suggestion_title">
                                        <i class="oi me-1" t-att-data-icon="group.icon"/>
                                        <t t-out="group.title"/>
                                    </div>
                                    <button t-foreach="group.items" t-as="item" t-key="item"
                                            class="o_aai_assistant_chip"
                                            t-on-click="() => this.useSuggestion(item)">
                                        <t t-out="item"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Conversation -->
                    <t t-foreach="this.state.messages" t-as="msg" t-key="msg.id">
                        <div t-attf-class="o_aai_assistant_msg o_aai_assistant_msg_{{ msg.role }}">
                            <img t-if="msg.role === 'user'" class="o_aai_assistant_avatar"
                                 t-att-src="this.userAvatar" alt=""/>
                            <div t-elif="msg.role === 'error'" class="o_aai_assistant_avatar o_aai_assistant_avatar_error">
                                <i class="oi" data-icon="priority_high"/>
                            </div>
                            <div t-else="" class="o_aai_assistant_avatar o_aai_assistant_avatar_bot">
                                <i class="oi" data-icon="wand_stars"/>
                            </div>

                            <div class="o_aai_assistant_body">
                                <div class="o_aai_assistant_bubble">
                                    <div class="o_aai_assistant_text" t-out="this.renderContent(msg)"/>

                                    <!-- PDF documents -->
                                    <div t-if="this.pdfLinks(msg).length" class="o_aai_assistant_files">
                                        <a t-foreach="this.pdfLinks(msg)" t-as="link" t-key="link.url"
                                           t-att-href="link.url" target="_blank" class="o_aai_assistant_file">
                                            <span class="o_aai_assistant_file_icon"><i class="oi" data-icon="picture_as_pdf"/></span>
                                            <span class="o_aai_assistant_file_name" t-out="link.label"/>
                                            <i class="oi o_aai_assistant_file_action" data-icon="download"/>
                                        </a>
                                    </div>

                                    <!-- Records to open in Odoo -->
                                    <div t-if="this.recordLinks(msg).length" class="o_aai_assistant_records">
                                        <a t-foreach="this.recordLinks(msg)" t-as="link" t-key="link.url"
                                           t-att-href="link.url" target="_blank" class="o_aai_assistant_chip">
                                            <i class="oi me-1" data-icon="open_in_new"/>
                                            <t t-out="link.label"/>
                                        </a>
                                    </div>
                                </div>

                                <div class="o_aai_assistant_meta">
                                    <span t-out="this.formatTime(msg)"/>
                                    <button t-if="msg.role === 'assistant'" class="o_aai_assistant_copy"
                                            title="Copy answer" t-on-click="() => this.copy(msg)">
                                        <i class="oi" data-icon="content_copy"/> Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Typing indicator -->
                    <div t-if="this.state.loading" class="o_aai_assistant_msg o_aai_assistant_msg_assistant">
                        <div class="o_aai_assistant_avatar o_aai_assistant_avatar_bot"><i class="oi" data-icon="wand_stars"/></div>
                        <div class="o_aai_assistant_body">
                            <div class="o_aai_assistant_bubble o_aai_assistant_typing">
                                <span/><span/><span/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Composer -->
                <footer class="o_aai_assistant_composer">
                    <div class="o_aai_assistant_input_wrap">
                        <textarea t-ref="this.inputRef" rows="1"
                                  placeholder="Ask about orders, invoices, stock…"
                                  t-model="this.input"
                                  t-on-input="this.onInput"
                                  t-on-keydown="this.onKeydown"
                                  t-att-disabled="this.state.loading"/>
                        <button class="o_aai_assistant_send" t-on-click="this.send"
                                t-att-disabled="!this.canSend" title="Send (Enter)">
                            <i class="oi" data-icon="send"/>
                        </button>
                    </div>
                    <div class="o_aai_assistant_hint">
                        <kbd>Enter</kbd> to send · <kbd>Shift</kbd>+<kbd>Enter</kbd> new line
                    </div>
                </footer>
            </div>

            <!-- ============================== Launcher ============================== -->
            <button t-elif="!this.props.fullPage" class="o_aai_assistant_launcher" title="Ask the AI Assistant"
                    aria-label="Open AI Assistant" t-on-click="this.toggle">
                <i class="oi" data-icon="wand_stars"/>
                <span class="o_aai_assistant_launcher_label">Ask AI</span>
            </button>
        </div>
    </t>

    <!-- Full-page chat (client action, opened in a new tab or from the AI Assistant menu) -->
    <t t-name="aai_odoo_assistance.ChatPage">
        <div class="o_aai_assistant_page o_action">
            <AiAssistantChat fullPage="true"/>
        </div>
    </t>
</templates>
